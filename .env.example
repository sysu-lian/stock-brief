# 复制为 .env 后填写。环境变量优先级高于 .env（方便 CI 用 Secrets 注入）。

# ---- 新闻通道（Tavily）：可选 ----
# 公告走巨潮资讯（cninfo）直连、行情走公开接口，**两者都不需要任何 Key**。
# 这里不填也完全可用：简报会只含交易所公告，并在末尾明确标注「新闻通道未配置」。
# 填了才会额外检索财经新闻；已配置但检索失败会直接报错，不会静默跳过。
# 托管体验站由运营方在服务端配置，绝不放进前端。
TAVILY_API_KEY=

# ---- 自托管定时推送必填 ----
# WebUI 体验站不需要这一项：用户的大模型密钥由页面表单临时传入，用完即弃，不落盘。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 6 位 A 股代码，逗号分隔。默认示例为中芯国际（科创板 688981）。
STOCK_LIST=688981

# 企业微信群机器人 Webhook（仅自托管定时推送用）
WECOM_WEBHOOK=

# 单只股票的模型调用超时（秒）
REQUEST_TIMEOUT=30

# 公告回看天数（巨潮直连，默认 3，范围 1–30）。周一建议 ≥3 以覆盖上周五盘后披露。
# ANNOUNCEMENT_DAYS_BACK=3

# 是否抽取公告 PDF 正文（默认 1 开启）。关闭后退化为「仅标题」，仍可正常生成简报。
# EXTRACT_ANNOUNCEMENT_BODY=1

# ---- 本机零 Key 体验（可选，公开站点请勿开启）----
# 开启后：行情/公告改用固定示例数据、模型默认指向 WorkBuddy 本机端点、
# 不查交易日历、不推机器人，只把简报打印出来；所有输出都会标注「演示数据」。
# 用法（无需任何密钥）：
#   LOCAL_DEMO=1 python -m src.main
#   LOCAL_DEMO=1 uvicorn web.app:app --port 8000
# 公开部署时务必删掉这一行，否则访客看到的会是示例数据而非真实数据。
# LOCAL_DEMO=1

# 本机模型端点示例（WorkBuddy 本机模型，OpenAI 兼容、无鉴权）：
# LLM_BASE_URL=http://127.0.0.1:52742/v1
# LLM_MODEL=local_model
# 自托管 WebUI 若想用本机模型但保留真实数据源，另设 ALLOW_LOCAL_LLM=1。
